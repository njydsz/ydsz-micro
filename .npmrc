# .npmrc — 仓库级 pnpm 配置
#
# v4.3.1 说明：
# - store-dir 显式指定：规避 pnpm storePathRelativeToHome 在 Windows 上的
#   临时目录 unlink 竞态（ENOENT/EPERM 反复导致 install 中断）。
# - registry 走国内镜像：CI 与本地网络对 registry.npmjs.org 直连不稳定。
#   如需发布 npm 包，发布命令请显式 --registry=https://registry.npmjs.org。

store-dir=D:\.pnpm-store

registry=https://registry.npmmirror.com
