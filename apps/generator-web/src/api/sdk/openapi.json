 "components": {
  "schemas": {
   "YdszResponse": {
    "type": "object",
    "properties": {
     "serialVersionUID": {
      "type": "integer",
      "format": "int64",
      "description": "序列化版本 UID，兼容 Lombok @SuperBuilder 生成的子类序列化。"
     },
     "code": {
      "type": "string",
      "description": "返回编码"
     },
     "msg": {
      "type": "string",
      "description": "返回信息"
     },
     "level": {
      "type": "string",
      "description": "异常级别。\n\n取值来自 com.njydsz.common.exception.enums.ExceptionLevel 枚举的 name：\n\n\nINFO — 静默处理，不展示 toast\nWARN — 轻量 toast 提示（auto-close 3s）\nERROR — toast 提示，需用户点击关闭\nFATAL — 弹窗提示，阻断用户当前操作\n\n\n成功响应不需要级别，为 `null` 时不序列化（通过 `@JsonInclude(NON_NULL)` 控制）。"
     },
     "data": {
      "type": "object",
