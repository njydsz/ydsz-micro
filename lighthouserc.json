{
  "ci": {
    "collect": {
      "startServerCommand": "pnpm preview",
      "startServerReadyPattern": "Local|localhost|ready",
      "url": [
        "http://localhost:5600/"
      ],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop"
      }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 0.9 }],
        "categories:performance": ["warn", { "minScore": 0.9 }],
        "first-contentful-paint": ["warn", { "maxNumericValue": 2000 }],
        "largest-contentful-paint": ["warn", { "maxNumericValue": 2500 }],
        "interactive": ["warn", { "maxNumericValue": 3800 }],
        "total-blocking-time": ["warn", { "maxNumericValue": 300 }],
        "cumulative-layout-shift": ["warn", { "maxNumericValue": 0.1 }],
        "speed-index": ["warn", { "maxNumericValue": 3400 }],
        "resource-summary:script:size": ["warn", { "maxNumericValue": 524288 }],
        "resource-summary:stylesheet:size": ["warn", { "maxNumericValue": 131072 }],
        "resource-summary:image:size": ["warn", { "maxNumericValue": 1048576 }],
        "resource-summary:third-party:size": ["warn", { "maxNumericValue": 262144 }],
        "resource-summary:dom:size": ["warn", { "maxNumericValue": 1500 }]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
