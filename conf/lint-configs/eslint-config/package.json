{
  "name": "@ydsz/eslint-config",
  "version": "1.0.0",
  "description": "YDSZ ESLint 配置 - 云顶微前端编码规范",
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist/",
    "src/"
  ],
  "scripts": {
    "build": "unbuild",
    "dev": "unbuild --watch",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "eslint": "^9.0.0"
  },
  "dependencies": {
    "@eslint/js": "catalog:",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-vue": "catalog:",
    "vue-eslint-parser": "catalog:"
  },
  "devDependencies": {
    "unbuild": "^2.0.0"
  },
  "author": "YDSZ Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/meituan/ydsz-micro"
  },
  "publishConfig": {
    "access": "restricted"
  }
}
