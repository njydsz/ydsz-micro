{
  "name": "@ydsz/eslint-config",
  "version": "1.0.0",
  "description": "YDSZ ESLint 配置 - 云顶微前端编码规范",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
