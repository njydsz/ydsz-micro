{
  "name": "@remi/main-web",
  "version": "1.0.0",
  "homepage": "https://remi.com",
  "bugs": "https://github.com/remi/remi/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/remi/vue-remi-admin.git",
    "directory": "main"
  },
  "license": "MIT",
  "author": {
    "name": "REMI Team",
    "email": "remi-team@remi.com",
    "url": "https://github.com/remi"
  },
  "type": "module",
  "remi": {
    "shareStrategy": "all"
  },
  "scripts": {
    "build": "pnpm vite build --mode production",
    "build:analyze": "pnpm vite build --mode analyze",
    "dev": "pnpm vite --mode development",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit --skipLibCheck"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "dependencies": {
    "@vueuse/core": "catalog:",
    "@remi-core/feature-flags": "workspace:*",
    "@remi/access": "workspace:*",
    "@remi/common-ui": "workspace:*",
    "@remi/constants": "workspace:*",
    "@remi/hooks": "workspace:*",
    "@remi/icons": "workspace:*",
    "@remi/layouts": "workspace:*",
    "@remi/locales": "workspace:*",
    "@remi/micro-kernel": "workspace:*",
    "@remi/micro-runtime": "workspace:*",
    "@remi/monitor": "workspace:*",
    "@remi/plugins": "workspace:*",
    "@remi/preferences": "workspace:*",
    "@remi/request": "workspace:*",
    "@remi/stores": "workspace:*",
    "@remi/styles": "workspace:*",
    "@remi/types": "workspace:*",
    "@remi/utils": "workspace:*",
    "dayjs": "catalog:",
    "element-plus": "catalog:",
    "pinia": "catalog:",
    "vue": "catalog:",
    "vue-router": "catalog:"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "unplugin-element-plus": "catalog:"
  }
}
