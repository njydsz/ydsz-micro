{
  "name": "ydsz-micro-monorepo",
  "version": "1.0.0",
  "private": true,
  "keywords": [
    "monorepo",
    "turbo",
    "YDSZ",
    "vue",
    "vue3",
    "micro-frontend"
  ],
  "description": "YDSZ 前端微应用 Monorepo — 基于 micro-kernel + Vue 3 + YDSZ Vue UI",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=8192 turbo build",
    "build:analyze": "turbo build:analyze",
    "build:main": "pnpm run build --filter=@ydsz/main-web",
    "build:userinfo": "pnpm run build --filter=@ydsz/userinfo-web",
    "build:system": "pnpm run build --filter=@ydsz/system-web",
    "build:message": "pnpm run build --filter=@ydsz/message-web",
    "build:cronjob": "pnpm run build --filter=@ydsz/cronjob-web",
    "build:generator": "pnpm run build --filter=@ydsz/generator-web",
    "build:workflow": "pnpm run build --filter=@ydsz/workflow-web",
    "build:nextwiki": "pnpm run build --filter=@ydsz/nextwiki-web",
    "build:literule": "pnpm run build --filter=@ydsz/literule-web",
    "build:agent": "pnpm run build --filter=@ydsz/agent-web",
    "build:chrome": "node ./chrome/build.mts",
    "build:docs-site": "pnpm run build --filter=@ydsz/docs-site",
    "type-check:chrome": "node --experimental-strip-types ./node_modules/typescript/bin/tsc -p chrome/tsconfig.json --noEmit",
    "changeset": "changeset",
    "changeset:publish": "changeset publish",
    "changeset:version": "changeset version",
    "check:i18n": "node ./bash/check-locales.mts",
    "tokens:export": "tsx comm/@core/ui-kit/design-tokens/src/figma-cli.mts export",
    "tokens:check": "tsx comm/@core/ui-kit/design-tokens/src/figma-cli.mts check",
    "check:size": "node ./bash/check-size.mts",
    "clean": "node ./bash/clean.mts",
    "commit": "czg",
    "dev": "turbo-run dev",
    "dev:main": "pnpm -F @ydsz/main-web run dev",
    "dev:userinfo": "pnpm -F @ydsz/userinfo-web run dev",
    "dev:system": "pnpm -F @ydsz/system-web run dev",
    "dev:message": "pnpm -F @ydsz/message-web run dev",
    "dev:cronjob": "pnpm -F @ydsz/cronjob-web run dev",
    "dev:generator": "pnpm -F @ydsz/generator-web run dev",
    "dev:workflow": "pnpm -F @ydsz/workflow-web run dev",
    "dev:nextwiki": "pnpm -F @ydsz/nextwiki-web run dev",
    "dev:literule": "pnpm -F @ydsz/literule-web run dev",
    "dev:agent": "pnpm -F @ydsz/agent-web run dev",
    "dev:docs-site": "pnpm -F @ydsz/docs-site run dev",
    "gen:api": "node ./bash/unified-contract.mts",
    "gen:api:check": "node ./bash/unified-contract.mts --check",
    "gen:api:static": "node ./bash/unified-contract.mts --static",
    "gen:api:legacy": "node ./bash/gen-api.mts",
    "gen:api:legacy:check": "node ./bash/gen-api.mts --check",
    "gen:app": "node ./bash/gen-app.mts",
    "gen:contract": "python ./bash/gen-contract.py",
    "gen:contract:check": "python ./bash/gen-contract.py --check",
    "gen:error-codes": "node ./bash/gen-error-codes.mts",
    "gen:error-codes:check": "node ./bash/gen-error-codes.mts --check",
    "gen:nginx": "node ./bash/gen-nginx-conf.mts",
    "gen:nginx:check": "node ./bash/gen-nginx-conf.mts --check",
    "gen:registry": "node ./bash/gen-registry.mts",
    "postinstall": "pnpm -r run stub --if-present",
    "preinstall": "npx only-allow pnpm",
    "prepare": "lefthook install",
    "preview": "turbo-run preview",
    "reinstall": "pnpm clean --del-lock && pnpm install",
    "standalone": "node ./bash/dev-standalone.mts",
    "standalone:userinfo": "node ./bash/dev-standalone.mts userinfo-web",
    "standalone:agent": "node ./bash/dev-standalone.mts agent-web --no-mock",
    "sync:shared-deps": "node ./bash/sync-shared-deps.mts",
    "sync:shared-deps:check": "node ./bash/sync-shared-deps.mts --check",
    "upload:sourcemaps": "node ./bash/upload-sourcemaps.mts",
    "update:deps": "npx taze -r -w",
    "lint": "cross-env NODE_OPTIONS=--max-old-space-size=8192 eslint . --max-warnings=0",
    "lint:fix": "cross-env NODE_OPTIONS=--max-old-space-size=8192 eslint . --fix",
    "format": "prettier --write . --cache",
    "format:check": "prettier --check . --cache",
    "type-check": "turbo type-check",
    "stylelint": "stylelint \"**/*.{vue,scss,css}\" --max-warnings=0",
    "stylelint:fix": "stylelint \"**/*.{vue,scss,css}\" --fix",
    "check:cspell": "cspell \"**/*.{ts,tsx,vue,mts,mjs}\" --gitignore --no-progress --no-summary",
    "vsh": "node --experimental-strip-types ./bash/vsh/bin/vsh.mts",
    "vsh:check-arch": "node --experimental-strip-types ./bash/vsh/bin/vsh.mts check-arch",
    "vsh:check-bundle": "node --experimental-strip-types ./bash/vsh/bin/vsh.mts check-bundle",
    "vsh:check-circular": "node --experimental-strip-types ./bash/vsh/bin/vsh.mts check-circular",
    "vsh:check-dep": "node --experimental-strip-types ./bash/vsh/bin/vsh.mts check-dep",
    "vsh:check-standard": "node --experimental-strip-types ./bash/vsh/bin/vsh.mts check-standard",
    "vsh:code-workspace": "node --experimental-strip-types ./bash/vsh/bin/vsh.mts code-workspace",
    "vsh:publint": "node --experimental-strip-types ./bash/vsh/bin/vsh.mts publint",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:unit:watch": "vitest --config vitest.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test --config=playwright.config.ts",
    "test:a11y:install": "playwright install chromium",
    "test:visual": "playwright test --config=playwright.visual.config.ts",
    "test:visual:update": "playwright test --config=playwright.visual.config.ts --update-snapshots",
    "test:visual:install": "playwright install chromium"
  },
  "devDependencies": {
    "@changesets/changelog-github": "catalog:",
    "@changesets/cli": "catalog:",
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@types/node": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@vitejs/plugin-vue-jsx": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vue/test-utils": "catalog:",
    "@ydsz/eslint-config": "workspace:*",
    "@ydsz/prettier-config": "workspace:*",
    "@ydsz/stylelint-config": "workspace:*",
    "@ydsz/tailwind-config": "workspace:*",
    "@ydsz/tsconfig": "workspace:*",
    "@ydsz/turbo-run": "workspace:*",
    "@ydsz/vite-config": "workspace:*",
    "autoprefixer": "catalog:",
    "cross-env": "catalog:",
    "cspell": "catalog:",
    "eslint": "catalog:",
    "happy-dom": "catalog:",
    "is-ci": "catalog:",
    "lefthook": "catalog:",
    "openapi-fetch": "catalog:",
    "openapi-typescript": "catalog:",
    "postcss-html": "catalog:",
    "postcss-scss": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-tailwindcss": "catalog:",
    "rimraf": "catalog:",
    "stylelint": "catalog:",
    "tailwindcss": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "unbuild": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vitest-axe": "^0.1.0",
    "@axe-core/playwright": "^4.10.1",
    "axe-core": "^4.10.0",
    "@playwright/test": "catalog:",
    "vue": "catalog:",
    "vue-sfc-transformer": "catalog:",
    "vue-tsc": "catalog:"
  },
  "prettier": "@ydsz/prettier-config",
  "engines": {
    "node": ">=20.10.0",
    "pnpm": ">=9.12.0"
  },
  "packageManager": "pnpm@10.27.0+sha512.72d699da16b1179c14ba9e64dc71c9a40988cbdc65c264cb0e489db7de917f20dcf4d64d8723625f2969ba52d4b7e2a1170682d9ac2a5dcaeaab732b7e16f04a",
  "pnpm": {
    "overrides": {
      "@ast-grep/napi": "catalog:",
      "@ctrl/tinycolor": "catalog:",
      "clsx": "catalog:",
      "esbuild": "0.25.3",
      "pinia": "catalog:",
      "vue": "catalog:"
    },
    "neverBuiltDependencies": [
      "canvas",
      "node-gyp"
    ]
  }
}
