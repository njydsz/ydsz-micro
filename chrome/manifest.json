{
  "manifest_version": 3,
  "name": "YDSZ Micro Kernel DevTools",
  "version": "4.1.0",
  "description": "YDSZ 运行时调试面板 — 监控子应用加载、keepAlive、状态、通信",
  "permissions": ["activeTab", "storage", "tabs", "scripting"],
  "host_permissions": [
    "http://localhost:*/*",
    "http://127.0.0.1:*/*",
    "https://*.his.example.com/*"
  ],
  "devtools_page": "dist/devtools/devtools.html",
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:*/*",
        "http://127.0.0.1:*/*",
        "https://*.his.example.com/*"
      ],
      "js": ["dist/content-script.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "dist/popup/popup.html",
    "default_title": "YDSZ Micro Kernel"
  },
  "web_accessible_resources": [
    {
      "resources": ["dist/kernel-bridge.js"],
      "matches": [
        "http://localhost:*/*",
        "http://127.0.0.1:*/*",
        "https://*.his.example.com/*"
      ]
    }
  ]
}
