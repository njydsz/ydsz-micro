# =====================================================================
# YDSZ 全栈环境变量 — 开发/测试环境示例
# --------------------------------------------------------------------
#  用法: cp .env.example .env 后按需修改
#  注意: 生产环境所有默认密码必须替换，此处仅供本地开发
# =====================================================================

# ==================== 网络端口 ====================
NACOS_PORT_HTTP=8848
NACOS_PORT_GRPC=9848
POSTGRES_PORT=5432
REDIS_PORT=6379
ROCKETMQ_NAMESRV_PORT=9876
ROCKETMQ_BROKER_PORT=10911
ROCKETMQ_BROKER_PORT2=10909
MINIO_API_PORT=9010
MINIO_CONSOLE_PORT=9011
GATEWAY_PORT=9000

# ==================== Nacos ====================
NACOS_AUTH_ENABLE=true
# Base64-encoded 32+ byte token (default: cloudsystems12345678901234567890123456789012)
NACOS_AUTH_TOKEN=Y2xvdWRzeXN0ZW1zMTIzNDU2Nzg5MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTI=

# ==================== PostgreSQL ====================
POSTGRES_USER=ydsz
POSTGRES_PASSWORD=Ydsz_Pg_2026
POSTGRES_DB=ydsz_cloud

# ==================== Redis ====================
REDIS_PASSWORD=Ydsz_Redis_2026

# ==================== MinIO ====================
MINIO_ROOT_USER=ydszminio
MINIO_ROOT_PASSWORD=Ydsz_Minio_2026
MINIO_SITE_REGION=cn-east-1

# ==================== 前端运行时配置 ====================
VITE_APP_BASE_URL=http://localhost:9000
VITE_APP_TENANT_ID=default

# ==================== 前端构建配置 ====================
VITE_USE_MOCK=false
VITE_APP_AUTH_TOKEN_STORAGE=localStorage
