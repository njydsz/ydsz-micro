{
  "name": "@ydsz/locales",
  "version": "5.5.9",
  "homepage": "https://github.com/ydsz/vue-ydsz-admin",
  "bugs": "https://github.com/ydsz/vue-ydsz-admin/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ydsz/vue-ydsz-admin.git",
    "directory": "comm/locales"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./errors": {
      "types": "./errors/index.ts",
      "default": "./errors/index.ts"
    },
    "./errors/*": {
      "types": "./errors/*",
      "default": "./errors/*"
    }
  },
  "dependencies": {
    "@intlify/core-base": "catalog:",
    "@ydsz-core/composables": "workspace:*",
    "@ydsz-core/shared": "workspace:*",
    "vue": "catalog:",
    "vue-i18n": "catalog:"
  }
}
