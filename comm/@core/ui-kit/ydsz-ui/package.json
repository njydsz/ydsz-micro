{
  "name": "@ydsz-core/ydsz-ui",
  "version": "5.5.9",
  "#main": "./dist/index.mjs",
  "#module": "./dist/index.mjs",
  "homepage": "https://github.com/ydsz/vue-ydsz-admin",
  "bugs": "https://github.com/ydsz/vue-ydsz-admin/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ydsz/vue-ydsz-admin.git",
    "directory": "comm/@core/ui-kit/ydsz-ui"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "ydsz-init": "./src/cli/index.ts",
    "ydsz-analyze": "./src/cli/analyze-bundle.ts"
  },
  "scripts": {
    "#build": "pnpm unbuild",
    "#prepublishOnly": "npm run build"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./src/index.ts",
  "module": "./src/nuxt.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./src/index.ts",
      "//default": "./dist/index.mjs"
    },
    "./components/*": {
      "types": "./src/components/*/index.ts",
      "default": "./src/components/*/index.ts"
    },
    "./ui/*": {
      "types": "./src/components/*/index.ts",
      "default": "./src/components/*/index.ts"
    },
    "./primitives/*": {
      "types": "./src/components/*/index.ts",
      "default": "./src/components/*/index.ts"
    },
    "./composables": {
      "types": "./src/composables/index.ts",
      "default": "./src/composables/index.ts"
    },
    "./locale": {
      "types": "./src/locale/index.ts",
      "default": "./src/locale/index.ts"
    },
    "./resolver": {
      "types": "./src/resolver.ts",
      "default": "./src/resolver.ts"
    },
    "./directives": {
      "types": "./src/directives/index.ts",
      "default": "./src/directives/index.ts"
    },
    "./css-vars-reference": {
      "types": "./src/css-vars-reference.ts",
      "default": "./src/css-vars-reference.ts"
    },
    "./nuxt": {
      "types": "./src/nuxt.ts",
      "default": "./src/nuxt.ts"
    },
    "./runtime/directives": {
      "types": "./src/runtime/use-directives.ts",
      "default": "./src/runtime/use-directives.ts"
    },
    "./pass-through": {
      "types": "./src/pass-through/index.ts",
      "default": "./src/pass-through/index.ts"
    },
    "./a11y/aria-role-map": {
      "types": "./src/a11y/aria-role-map.ts",
      "default": "./src/a11y/aria-role-map.ts"
    },
    "./a11y/test-utils": {
      "types": "./src/a11y/a11y-test-utils.ts",
      "default": "./src/a11y/a11y-test-utils.ts"
    },
    "./motion/tokens": {
      "types": "./src/motion/motion-tokens.ts",
      "default": "./src/motion/motion-tokens.ts"
    },
    "./cli": {
      "types": "./src/cli/index.ts",
      "default": "./src/cli/index.ts"
    },
    "./cli/analyze": {
      "types": "./src/cli/analyze-bundle.ts",
      "default": "./src/cli/analyze-bundle.ts"
    },
    "./motion/use-reduced-motion": {
      "types": "./src/motion/useReducedMotion.ts",
      "default": "./src/motion/useReducedMotion.ts"
    },
    "./ssr/client-only": {
      "types": "./src/ssr/ClientOnly.vue",
      "default": "./src/ssr/ClientOnly.vue"
    },
    "./styles/reduced-motion": {
      "default": "./src/styles/reduced-motion.css"
    },
    "./styles/rtl": {
      "default": "./src/styles/rtl.css"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "default": "./src/index.ts"
      },
      "./resolver": {
        "default": "./src/resolver.ts"
      }
    }
  },
  "dependencies": {
    "@tanstack/vue-virtual": "catalog:",
    "@vueuse/core": "catalog:",
    "@ydsz-core/composables": "workspace:*",
    "@ydsz-core/design-tokens": "workspace:*",
    "@ydsz-core/icons": "workspace:*",
    "@ydsz-core/shared": "workspace:*",
    "@ydsz-core/typings": "workspace:*",
    "@ydsz-core/ydsz-vue": "workspace:*",
    "@ydsz/request": "workspace:*",
    "class-variance-authority": "catalog:",
    "lucide-vue-next": "catalog:",
    "sortablejs": "catalog:",
    "vee-validate": "catalog:",
    "vue": "catalog:"
  },
  "peerDependencies": {
    "unplugin-vue-components": ">=27.0.0"
  },
  "peerDependenciesMeta": {
    "unplugin-vue-components": {
      "optional": true
    }
  }
}
