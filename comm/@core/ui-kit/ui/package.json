{
  "name": "@ydsz-core/ui",
  "version": "1.0.0",
  "description": "YDSZ Vue UI — 统一组件库入口，聚合全部自研 UI 组件（Yd 前缀）",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./global-css": "./src/global-css.ts",
    "./ydsz-ui": {
      "types": "./src/ydsz-ui.ts",
      "default": "./src/ydsz-ui.ts"
    },
    "./form": {
      "types": "./src/form.ts",
      "default": "./src/form.ts"
    },
    "./popup": {
      "types": "./src/popup.ts",
      "default": "./src/popup.ts"
    },
    "./menu": {
      "types": "./src/menu.ts",
      "default": "./src/menu.ts"
    },
    "./tabs": {
      "types": "./src/tabs.ts",
      "default": "./src/tabs.ts"
    },
    "./layout": {
      "types": "./src/layout.ts",
      "default": "./src/layout.ts"
    },
    "./editor": {
      "types": "./src/editor.ts",
      "default": "./src/editor.ts"
    }
  },
  "dependencies": {
    "@ydsz-core/ydsz-ui": "workspace:*",
    "@ydsz-core/form-ui": "workspace:*",
    "@ydsz-core/popup-ui": "workspace:*",
    "@ydsz-core/menu-ui": "workspace:*",
    "@ydsz-core/tabs-ui": "workspace:*",
    "@ydsz-core/layout-ui": "workspace:*",
    "@ydsz-core/editor-ui": "workspace:*"
  }
}
