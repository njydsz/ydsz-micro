{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../../../conf/tsconfig/base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["node"],
    "lib": ["ESNext", "DOM", "DOM.Iterable"]
  },
  "include": ["src/**/*.ts", "src/**/*.mts"],
  "exclude": ["**/node_modules/**", "**/dist/**"]
}
