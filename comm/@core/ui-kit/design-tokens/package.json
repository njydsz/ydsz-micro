{
  "name": "@ydsz-core/design-tokens",
  "version": "1.0.0",
  "homepage": "https://github.com/ydsz/vue-ydsz-admin",
  "bugs": "https://github.com/ydsz/vue-ydsz-admin/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ydsz/vue-ydsz-admin.git",
    "directory": "comm/@core/ui-kit/design-tokens"
  },
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./styles/variables.css": "./src/styles/variables.css",
    "./styles/compat-aliases.css": "./src/styles/compat-aliases.css",
    "./composables": {
      "types": "./src/composables/index.ts",
      "development": "./src/composables/index.ts",
      "default": "./src/composables/index.ts"
    },
    "./density": {
      "types": "./src/tokens/density.ts",
      "development": "./src/tokens/density.ts",
      "default": "./src/tokens/density.ts"
    },
    "./transition-utils": {
      "types": "./src/tokens/transition-utils.ts",
      "development": "./src/tokens/transition-utils.ts",
      "default": "./src/tokens/transition-utils.ts"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "default": "./dist/index.mjs"
      }
    }
  },
  "dependencies": {
    "vue": "catalog:"
  },
  "devDependencies": {}
}
